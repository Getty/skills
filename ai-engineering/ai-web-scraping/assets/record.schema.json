{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ai-web-scraping/evidence-record-v1.json",
  "title": "Narrow text evidence record, version 1.0",
  "$comment": "Structural companion only. Enable format assertions. validate_evidence.py additionally rejects float lexemes, validates normalization, paths, hashes, spans and unique record IDs. This schema is not fetched by the helper.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "fetched_at",
        "snapshot_ref",
        "snapshot_sha256",
        "record_span"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "normalization",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "absent",
            "explicit_null",
            "unparseable",
            "conflict"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "normalization": {
          "enum": [
            "exact",
            "whitespace",
            "decimal_dot",
            "integer",
            "boolean_literal",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              "normalization": {
                "enum": [
                  "exact",
                  "whitespace",
                  "decimal_dot",
                  "integer",
                  "boolean_literal"
                ]
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "note"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "normalization": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "absent"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "explicit_null",
                  "unparseable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization": {
                "enum": [
                  "exact",
                  "whitespace",
                  "decimal_dot"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "normalization": {
                "const": "boolean_literal"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
