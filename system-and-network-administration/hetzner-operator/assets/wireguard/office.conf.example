# EXAMPLE ONLY. The office initiates; 203.0.113.10 is a documentation address.
[Interface]
Address = 10.77.0.2/32
PrivateKey = REPLACE_WITH_OFFICE_PRIVATE_KEY
MTU = 1380

[Peer]
PublicKey = REPLACE_WITH_HUB_PUBLIC_KEY
Endpoint = 203.0.113.10:51820
AllowedIPs = 10.70.0.0/16, 10.77.0.1/32
# Keep the upstream NAT mapping alive when idle; useful for a NATed office.
PersistentKeepalive = 25
