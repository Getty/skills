{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gearman skill sum.v1 request",
  "description": "Demo contract. Additional wire rules: UTF-8, at most 65536 bytes, integer tokens rather than floating tokens, and strict duplicate-key rejection at untrusted ingress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "operation": {
      "const": "sum.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numbers"
      ],
      "properties": {
        "numbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    },
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
