# TEMPLATE: inspect binary options, create the service user, and review before enabling.
[Unit]
Description=Gearman single-owner SQLite example
After=network.target

[Service]
Type=simple
User=gearman
Group=gearman
StateDirectory=gearman-skill
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/sbin/gearmand --listen=127.0.0.1 --port=4730 --queue-type=libsqlite3 --libsqlite3-db=/var/lib/gearman-skill/queue.sqlite --job-retries=3 --verbose=NOTICE --log-file=stderr
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
